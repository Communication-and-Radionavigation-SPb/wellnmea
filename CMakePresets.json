{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "hidden": true
    },
    {
      "name": "dev",
      "displayName": "Development",
      "inherits": "generator",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WELLNMEA_BUILD_TESTS": "ON",
        "WELLNMEA_BUILD_EXAMPLES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_INSTALLED_DIR": {
          "type": "FILEPATH",
          "value": "${sourceDir}/vcpkg_installed"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Compiles with debug information",
      "configuration": "Debug",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Compiles with optimization enabled",
      "configuration": "Release",
      "configurePreset": "dev"
    }
  ],
  "testPresets": [
    {
      "name": "default-tests",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "default-tests",
      "configuration": "Debug",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "inherits": "default-tests",
      "configuration": "Release",
      "configurePreset": "dev"
    }
  ]
}
